<pc:PropertyControlBase x:Class="NiVE3.OpenFX.Bridge.Property.Control.OfxButtonPropertyControl"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:NiVE3.OpenFX.Bridge.Property.Control"
                        xmlns:pc="clr-namespace:NiVE3.Plugin.Property.Control;assembly=NiVE3.Plugin"
                        xmlns:ucv="clr-namespace:NiVE3.UI.Converter;assembly=NiVE3.UI"
                        mc:Ignorable="d"
                        x:Name="Root"
                        d:DesignHeight="450" d:DesignWidth="800">
    <pc:PropertyControlBase.Resources>
        <ucv:BooleanInvertConverter x:Key="BooleanInvertConverter"/>
    </pc:PropertyControlBase.Resources>
    <Grid>
        <Button MinWidth="{Binding Property.MinButtonWidth}"
                Margin="5,2,0,2"
                Padding="12,2,12,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding Property.DisplayName}"
                IsEnabled="{Binding ParentLayerIsLock, Converter={StaticResource BooleanInvertConverter}}"
                Click="Button_Click"/>
    </Grid>
</pc:PropertyControlBase>
